# ==============================================================================
# Council of Minds - Project .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Configuration
# ------------------------------------------------------------------------------
# Ignore environment variables containing sensitive secrets (API keys, DB URLs)
.env
.env.*
!.env.example
!.env.template

# ------------------------------------------------------------------------------
# 2. Python / Backend (FastAPI, LangGraph)
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Caches and testing artifacts
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# ------------------------------------------------------------------------------
# 3. Node.js / Frontend (React + Vite)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/

# Build output
dist/
build/

# Vite specific
.vite/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 4. IDE / OS Files (Windows Environment)
# ------------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains / IntelliJ
.idea/

# Windows OS
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS (just in case it's cloned on a Mac later)
.DS_Store

# ------------------------------------------------------------------------------
# 5. Application Data, Uploads, & Vector Store Caches
# ------------------------------------------------------------------------------
# Uploaded PDFs and temp document processing files
backend/uploads/
backend/documents/
*.pdf

# OCR and temporary chunking artifacts
backend/ocr_output/
backend/temp/
backend/scratch/
*.tmp
*.temp

# Embedding caches and local vector stores (if used locally)
backend/vector_cache/
backend/chroma_db/
backend/embeddings/
*.faiss
*.pkl

# ------------------------------------------------------------------------------
# 6. Logs & Telemetry
# ------------------------------------------------------------------------------
*.log
backend/logs/
frontend/logs/

# ------------------------------------------------------------------------------
# 7. Exceptions (Always Include)
# ------------------------------------------------------------------------------
# Explicitly track migrations and requirements
!backend/alembic/versions/*.py
!backend/requirements.txt
!backend/pyproject.toml
!frontend/package.json
!frontend/package-lock.json
backend/.local_vectorstore.json